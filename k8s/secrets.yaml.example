apiVersion: v1
kind: Secret
metadata:
  name: medguide-secrets
  namespace: medguide-prod
type: Opaque
stringData:
  # Database connection to AWS RDS PostgreSQL
  DATABASE_URL: "postgresql://medguide_admin:YOUR_SECURE_PASSWORD@medguide-prod-db.xxxx.us-east-1.rds.amazonaws.com:5432/medguide_production"
  
  # Redis Cluster connection to AWS ElastiCache
  REDIS_URL: "rediss://medguide-prod-cache.xxxx.us-east-1.cache.amazonaws.com:6379/0"
  
  # AI Provider API Keys
  GEMINI_API_KEY: "your_gemini_api_key_here"
  ANTHROPIC_API_KEY: "your_anthropic_api_key_here"
  OPENAI_API_KEY: "your_openai_api_key_here"
  PINECONE_API_KEY: "your_pinecone_api_key_here"
  TAVILY_API_KEY: "your_tavily_api_key_here"
  
  # LangSmith Tracing
  LANGCHAIN_API_KEY: "your_langsmith_api_key_here"
  
  # Optional API Token
  API_TOKEN: "your_64_character_production_api_token"
