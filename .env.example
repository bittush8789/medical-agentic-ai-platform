# ========================================================
# MedGuide AI — Multi-Model Medical Agent Configuration
# ========================================================

# --- API Keys ---
# Google Gemini (Supports Gemini 3.8 / 2.5 Flash, 2.0 Flash)
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic Claude (Supports Claude 3.5 Sonnet, Claude 3.5 Haiku)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI (Supports GPT-4.1 Mini, GPT-4o, Whisper Audio & Embeddings)
OPENAI_API_KEY=your_openai_api_key_here

# Pinecone Vector Database (Required for Knowledge Base retrieval)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=medical-agent-demo

# Tavily AI Search (Optional: Fallback for latest real-time clinical guidelines)
TAVILY_API_KEY=your_tavily_api_key_here

# --- Default Chat Model ---
# Choose from:
# - gemini/gemini-2.5-flash  (Gemini 3.8 / 2.5 Flash)
# - gemini/gemini-2.0-flash  (Gemini 2.0 Flash)
# - claude-3-5-sonnet-20241022 (Claude 3.5 Sonnet)
# - claude-3-5-haiku-20241022  (Claude 3.5 Haiku)
# - gpt-4.1-mini              (OpenAI GPT-4.1 Mini)
# - gpt-4o-mini               (OpenAI GPT-4o Mini)
CHAT_MODEL=gemini/gemini-2.5-flash

# --- LLM Gateway: Automatic Model Fallback ---
# Comma-separated fallback chain (tried in order when primary model fails)
# The gateway will try primary model first, then each fallback until one succeeds
FALLBACK_MODELS=gemini/gemini-2.5-flash,claude-3-5-sonnet-20241022,gpt-4.1-mini

# Maximum number of models to try (including primary) before giving up
MAX_FALLBACK_RETRIES=3

# Timeout per model call in seconds
GATEWAY_TIMEOUT=45

# --- Audit Logging ---
ENABLE_AUDIT_LOGGING=true

# --- Guardrails: Microsoft Presidio (PII) + NVIDIA NeMo Guardrails (Safety) ---
# Enforce PII masking (HIPAA privacy) and clinical safety rails
ENABLE_GUARDRAILS=true
ENABLE_PRESIDIO_PII=true
ENABLE_NEMO_GUARDRAILS=true

# --- LangSmith Observability & Tracing ---
# Set your LangSmith API key from smith.langchain.com for full agent graph tracing & latency breakdown
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=medical-agentic-chatbot
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# --- Redis Caching & Distributed Session Layer ---
# URL for Redis instance (e.g., redis://localhost:6379/0 or rediss://... for Upstash/Cloud)
# System automatically falls back to high-performance in-memory cache if Redis is offline
REDIS_URL=redis://localhost:6379/0
ENABLE_REDIS_CACHE=true

# --- Agent Governance & Guardrail Policies ---
# Enforce tool execution authorization, circuit breakers, rate limits, and turn tool budgets
ENABLE_AGENT_GOVERNANCE=true
MAX_TOOL_CALLS_PER_TURN=6
RATE_LIMIT_RPM=60

# --- LangMem: Long-Term Patient Clinical Memory ---
# Enables cross-conversation extraction and recall of allergies, chronic conditions, and medications
ENABLE_LANGMEM=true

# --- Enterprise AI Security Engine (OWASP Top 10 for LLMs) ---
# Active defenses for direct/indirect prompt injection, memory poisoning, and exfiltration
ENABLE_AI_SECURITY=true
ENABLE_INDIRECT_INJECTION_DEFENSE=true
ENABLE_MEMORY_POISONING_DEFENSE=true
ENABLE_EXFILTRATION_DEFENSE=true

# --- Security & Settings (Optional) ---
# API_TOKEN=your_secure_secret_token
# ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

